# 复制本文件为 .env.development，再填入你自己的密钥
# .env.* 已被 .gitignore 排除，不会上传到仓库

# 运行环境：development / test / production
APP_ENV=development

# DeepSeek API Key（申请地址 https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# 使用的模型名：deepseek-flash 或 deepseek-v4-pro
MODEL=deepseek-flash
